# Límite de antigüedad de la última observación real REData para permitir prever.
MAX_DEMAND_AGE_HOURS=6

# Ventana consultada a la API oficial de demanda REData.
DEMAND_LOOKBACK_DAYS=14

# Solicita el token personal a REE/ESIOS y configúralo localmente; nunca lo añadas al repositorio.
ESIOS_API_TOKEN=

# Tiempo máximo de espera del dashboard a la API local de FastAPI.
API_TIMEOUT_SECONDS=35

# Base de datos PostgreSQL (Supabase) para el registro de previsiones y load_to_db.py.
# Cadena de conexión del "Session pooler" (Project Settings > Database > Connect).
# Opcional: sin ella la aplicación funciona igual, sin registro de previsiones.
DATABASE_URL=

# Opcionales, solo para load_to_db.py: rutas de los Parquet a cargar.
# Si no se definen, se usan los ficheros de data/raw/.
# RUTA_DEMANDA=
# RUTA_METEO=
# RUTA_PRECIO=
